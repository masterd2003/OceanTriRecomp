// Ciudad offline (local_server.h): arranca, oculto y solo cuando el juego usa la
// red por primera vez, el MH3SP local que hay en OnlineLocal\ junto al exe, y
// apunta el modo online del port a el.
#include "local_server.h"

#include "nas_server.h"
#include "online.h"

#ifdef _WIN32
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
