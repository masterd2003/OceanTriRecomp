void ApplyWindowStyle() {
    if (!g_panelWindow) return;
    const Theme& t = CurrentTheme();
    const BYTE alpha = t.style == 0 ? 246 : (t.style == 2 ? 250 : 255);
    SetLayeredWindowAttributes(g_panelWindow, 0, alpha, LWA_ALPHA);
    // Prefer compositor-rendered Win11 corners; use a rounded region on older Windows.
    const DWORD roundPreference = 2; // DWMWCP_ROUND
    const HRESULT cornerStatus = DwmSetWindowAttribute(g_panelWindow, 33, &roundPreference, sizeof(roundPreference));
    if (SUCCEEDED(cornerStatus)) {
        SetWindowRgn(g_panelWindow, nullptr, TRUE);
    } else {
        const int diameter = 56;
        SetWindowRgn(g_panelWindow, CreateRoundRectRgn(0, 0, PanelWidth + 1, PanelHeight + 1, diameter, diameter), TRUE);
    }
    DWM_BLURBEHIND blur{};
    blur.dwFlags = DWM_BB_ENABLE;
    blur.fEnable = t.style == 0;
    DwmEnableBlurBehindWindow(g_panelWindow, &blur);
    MARGINS margins = t.style == 0 ? MARGINS{1,1,1,1} : MARGINS{0,0,0,0};
    DwmExtendFrameIntoClientArea(g_panelWindow, &margins);
}
void SetBackdropArt(HDC dc, const Theme& t) {
    RECT bounds{0,0,PanelWidth,PanelHeight};
    FillSolid(dc, bounds, t.bg);
    if (t.style == 1) {
