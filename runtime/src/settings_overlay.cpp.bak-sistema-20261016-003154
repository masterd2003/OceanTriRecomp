    }
}
bool RegisterWindowClass(const wchar_t* name,WNDPROC proc){
    WNDCLASSEXW c{};c.cbSize=sizeof(c);c.lpfnWndProc=proc;c.hInstance=GetModuleHandleW(nullptr);
    c.hCursor=LoadCursorW(nullptr,MAKEINTRESOURCEW(32512));c.hbrBackground=nullptr;c.lpszClassName=name;
    if(RegisterClassExW(&c)) return true;
    return GetLastError()==ERROR_CLASS_ALREADY_EXISTS;
}
void EnsureWindows(){
    if(!g_hostWindow||!IsWindow(g_hostWindow))return;
    HINSTANCE inst=GetModuleHandleW(nullptr);
    if(!g_panelWindow&&RegisterWindowClass(OverlayClassName,PanelProc)){
        g_panelWindow=CreateWindowExW(WS_EX_TOOLWINDOW|WS_EX_LAYERED|WS_EX_TOPMOST,OverlayClassName,L"Monster Hunter Tri - Ajustes",WS_POPUP,CW_USEDEFAULT,CW_USEDEFAULT,PanelWidth,PanelHeight,g_hostWindow,nullptr,inst,nullptr);
        if(g_panelWindow){ShowWindow(g_panelWindow,SW_HIDE);ApplyWindowStyle();}
    }
    if(!g_hudWindow&&RegisterWindowClass(HudClassName,HudProc)){
        g_hudWindow=CreateWindowExW(WS_EX_TOOLWINDOW|WS_EX_NOACTIVATE|WS_EX_TOPMOST,HudClassName,L"MH3 FPS",WS_POPUP,CW_USEDEFAULT,CW_USEDEFAULT,HudWidth,HudHeight,g_hostWindow,nullptr,inst,nullptr);
        if(g_hudWindow){
            const DWORD roundPreference=2;
            if(FAILED(DwmSetWindowAttribute(g_hudWindow,33,&roundPreference,sizeof(roundPreference)))
               && !SetWindowRgn(g_hudWindow,CreateRoundRectRgn(0,0,HudWidth+1,HudHeight+1,28,28),TRUE)) {
                // Keep a valid rectangular HUD if this Windows version cannot round popup windows.
            }
            ShowWindow(g_hudWindow,SW_HIDE);
        }
    }
}
void DispatchWindowMessages(HWND w){if(!w)return;MSG m{};while(PeekMessageW(&m,w,0,0,PM_REMOVE)){TranslateMessage(&m);DispatchMessageW(&m);}}
