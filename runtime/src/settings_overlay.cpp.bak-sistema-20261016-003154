constexpr std::array<float, 6> RenderScales{{540.0f/448.0f, 720.0f/448.0f, 900.0f/448.0f, 1080.0f/448.0f, 1440.0f/448.0f, 2160.0f/448.0f}};
constexpr std::array<const char*, 6> RenderScaleEnvironmentValues{{"1.2053571", "1.6071429", "2.0089286", "2.4107143", "3.2142857", "4.8214286"}};
void ApplyRenderResolution(int idx) {
    if(g_resolutions.empty()) LoadResolutions();
    if(g_resolutions.empty()) return;
    g_resolutionIndex=static_cast<size_t>(std::clamp(idx,0,int(g_resolutions.size())-1));
    const size_t scaleIndex=std::min(g_resolutionIndex,RenderScales.size()-1);
    // Aurora's VISetFrameBufferScale schedules an ordered framebuffer/swapchain resize.
    // This changes the 3D render target, not the SDL window dimensions.
    VISetFrameBufferScale(RenderScales[scaleIndex]);
#ifdef _WIN32
    _putenv_s("MH3_RENDER_SCALE", RenderScaleEnvironmentValues[scaleIndex]);
#else
    setenv("MH3_RENDER_SCALE", RenderScaleEnvironmentValues[scaleIndex], 1);
#endif
    SaveGraphicsSettings();
    if(g_panelWindow) InvalidateRect(g_panelWindow,nullptr,FALSE);
}
