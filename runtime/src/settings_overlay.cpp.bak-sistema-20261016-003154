    } else if (t.style == 5) {
        FillSolid(dc, RECT{0,0,PanelWidth,PanelHeight}, t.bg);
        for (int y = 6; y < PanelHeight; y += 6)
            Line(dc, 8, y, PanelWidth - 8, y, RGB(222,204,158), 1);
    }
    RECT outer{8,8,PanelWidth-8,PanelHeight-8};
    DrawCard(dc, outer, t.panel, t.border, 24);
    DrawThemeTexture(dc, t);
    if (t.style == 0) {
        // Soft mist: low-contrast concentric arcs, without glossy glass reflections.
        HPEN mist = CreatePen(PS_SOLID, 1, t.border);
        if (mist) { HGDIOBJ old=SelectObject(dc,mist); Arc(dc,505,78,692,155,528,116,664,94); Arc(dc,513,85,681,148,535,118,657,98); SelectObject(dc,old); DeleteObject(mist); }
    } else if (t.style == 2) {
