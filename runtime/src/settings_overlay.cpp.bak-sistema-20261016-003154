void AdvancePresentedFrame() noexcept {
    EnsureWindows();
    if(!g_showFps||!g_hudWindow)return;
    const auto now=std::chrono::steady_clock::now();
    g_lastPresentedSignal=now;
    ++g_frameCount;
    const double elapsed=std::chrono::duration<double>(now-g_lastFpsUpdate).count();
    if(elapsed>=0.5){
        g_fps=double(g_frameCount)/elapsed;g_frameCount=0;g_lastFpsUpdate=now;
        if(!g_panelVisible){
            if(!IsWindowVisible(g_hudWindow))ShowWindow(g_hudWindow,SW_SHOWNOACTIVATE);
            PositionHud();SetWindowPos(g_hudWindow,HWND_TOPMOST,0,0,0,0,SWP_NOMOVE|SWP_NOSIZE|SWP_NOACTIVATE|SWP_SHOWWINDOW);
            InvalidateRect(g_hudWindow,nullptr,TRUE);RedrawWindow(g_hudWindow,nullptr,nullptr,RDW_INVALIDATE|RDW_UPDATENOW|RDW_NOERASE);
        }
        if(g_panelVisible&&g_panelWindow)InvalidateRect(g_panelWindow,nullptr,TRUE);
    }
}
