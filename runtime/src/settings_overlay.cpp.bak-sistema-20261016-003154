void AttachWindow(SDL_Window* window) noexcept {
    g_sdlWindow=window;g_hostWindow=nullptr;
    if(window){SDL_PropertiesID p=SDL_GetWindowProperties(window);g_hostWindow=static_cast<HWND>(SDL_GetPointerProperty(p,SDL_PROP_WINDOW_WIN32_HWND_POINTER,nullptr));}
}
void InitializeRuntimeSettings() noexcept {
    g_showFps=RuntimeConfigFile::ShowFps(true);LoadTheme();LoadGraphicsSettings();LoadResolutions();EnsureWindows();
    g_frameCount=0;g_fps=0.0;g_lastFpsUpdate=std::chrono::steady_clock::now();g_lastPresentedSignal=g_lastFpsUpdate;
    if(g_hudWindow){if(g_showFps){ShowWindow(g_hudWindow,SW_SHOWNOACTIVATE);PositionHud();SetWindowPos(g_hudWindow,HWND_TOPMOST,0,0,0,0,SWP_NOMOVE|SWP_NOSIZE|SWP_NOACTIVATE|SWP_SHOWWINDOW);InvalidateRect(g_hudWindow,nullptr,TRUE);}else ShowWindow(g_hudWindow,SW_HIDE);}
}
void HandleEvents(const AuroraEvent* events) noexcept {
    if(!events)return;
    for(const AuroraEvent*e=events;e->type!=AURORA_NONE;++e){
        if(e->type!=AURORA_SDL_EVENT||e->sdl.type!=SDL_EVENT_KEY_DOWN||e->sdl.key.repeat)continue;
        const SDL_Keycode k=e->sdl.key.key;
        if(k==SDLK_ESCAPE||k==SDLK_F1){EnsureWindows();ToggleVisible();}
    }
}
void Pump() noexcept {
    EnsureWindows();DispatchWindowMessages(g_panelWindow);DispatchWindowMessages(g_hudWindow);
    if(g_showFps&&g_hudWindow){
        if(g_panelVisible){if(IsWindowVisible(g_hudWindow))ShowWindow(g_hudWindow,SW_HIDE);}
        else{if(!IsWindowVisible(g_hudWindow))ShowWindow(g_hudWindow,SW_SHOWNOACTIVATE);PositionHud();}
        // Fallback: some renderer paths do not emit the frame-seal callback every present.
        const auto now=std::chrono::steady_clock::now();
        if(now-g_lastPresentedSignal>std::chrono::milliseconds(750)){
            ++g_frameCount;
            const double elapsed=std::chrono::duration<double>(now-g_lastFpsUpdate).count();
            if(elapsed>=0.5){g_fps=double(g_frameCount)/elapsed;g_frameCount=0;g_lastFpsUpdate=now;if(!g_panelVisible){PositionHud();InvalidateRect(g_hudWindow,nullptr,TRUE);UpdateWindow(g_hudWindow);}else if(g_panelWindow)InvalidateRect(g_panelWindow,nullptr,TRUE);}
        }
    }else if(g_hudWindow&&IsWindowVisible(g_hudWindow))ShowWindow(g_hudWindow,SW_HIDE);
    if(g_panelVisible)PositionPanel();
}
