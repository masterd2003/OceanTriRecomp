RECT DropdownRect() {
    if(g_dropdown==Dropdown::Theme) return ThemePopupRect();
    if(g_dropdown==Dropdown::Font) return FontPopupRect();
    if(g_dropdown==Dropdown::Antialiasing) return AntialiasingPopupRect();
    if(g_dropdown==Dropdown::FrameRate) return FrameLimitPopupRect();
    return ResolutionPopupRect();
}
int DropdownMaxScroll() {
    if(g_dropdown==Dropdown::Theme) return std::max(0,int(Themes.size())-DropdownRowsTheme);
    if(g_dropdown==Dropdown::Resolution) return std::max(0,int(g_resolutions.size())-DropdownRowsResolution);
    if(g_dropdown==Dropdown::FrameRate) return std::max(0,int(FrameRateNames.size())-DropdownRowsFrameRate);
    return 0;
}
int DropdownVisibleRows() {
    if(g_dropdown==Dropdown::Theme) return DropdownRowsTheme;
    if(g_dropdown==Dropdown::Font) return DropdownRowsFont;
    if(g_dropdown==Dropdown::Antialiasing) return DropdownRowsAntialiasing;
    if(g_dropdown==Dropdown::FrameRate) return DropdownRowsFrameRate;
    return DropdownRowsResolution;
}
int DropdownRowHeight() {
    if(g_dropdown==Dropdown::Theme) return DropdownThemeRowH;
    if(g_dropdown==Dropdown::Font) return DropdownFontRowH;
    if(g_dropdown==Dropdown::Antialiasing) return DropdownAntialiasingRowH;
    if(g_dropdown==Dropdown::FrameRate) return DropdownFrameRateRowH;
    return DropdownResolutionRowH;
}
int DropdownTopScroll() {
    if(g_dropdown==Dropdown::Theme) return g_themeScroll;
    if(g_dropdown==Dropdown::Resolution) return g_resolutionScroll;
    return 0;
}
void SetDropdownScroll(int value) {
    value=std::clamp(value,0,DropdownMaxScroll());
    if(g_dropdown==Dropdown::Theme)g_themeScroll=value;else if(g_dropdown==Dropdown::Resolution)g_resolutionScroll=value;
}
void OpenDropdown(Dropdown d) {
    g_dropdown=d;g_dropdownHover=-1;
    if(d==Dropdown::Theme) g_themeScroll=std::clamp(g_themeIndex-2,0,std::max(0,int(Themes.size())-DropdownRowsTheme));
    else if(d==Dropdown::Resolution) g_resolutionScroll=std::clamp(int(g_resolutionIndex)-1,0,std::max(0,int(g_resolutions.size())-DropdownRowsResolution));
}
int DropdownItemAt(POINT p) {
    if(g_dropdown==Dropdown::None || !Contains(DropdownRect(),p))return -1;
    const RECT r=DropdownRect();
    const int top=r.top+25;
    const int row= (p.y-top)/DropdownRowHeight();
    if(p.y<top || row<0 || row>=DropdownVisibleRows())return -1;
    const int idx=DropdownTopScroll()+row;
    const int count=g_dropdown==Dropdown::Theme?int(Themes.size()):g_dropdown==Dropdown::Font?int(FontFaces.size()):g_dropdown==Dropdown::Antialiasing?int(AntialiasingNames.size()):g_dropdown==Dropdown::FrameRate?int(FrameRateNames.size()):int(g_resolutions.size());
    return idx>=0&&idx<count?idx:-1;
}
void DrawDropdown(HDC dc,const Theme& t) {
    if(g_dropdown==Dropdown::None)return;
    const RECT r=DropdownRect();
    DrawCard(dc,r,t.panel,t.accent,12);
    const wchar_t* caption=g_dropdown==Dropdown::Theme?L"TEMAS":g_dropdown==Dropdown::Font?L"TIPOGRAFÍA":g_dropdown==Dropdown::Antialiasing?L"ANTIALIASING":g_dropdown==Dropdown::FrameRate?L"LÍMITE DE FPS":L"RESOLUCIÓN";
    Text(dc,r.left+10,r.top+3,r.right-r.left-20,21,caption,9,t.accent,FW_BOLD);
    const int rowH=DropdownRowHeight(),rows=DropdownVisibleRows(),first=DropdownTopScroll();
    for(int i=0;i<rows;++i){
        const int idx=first+i;
        const int y=r.top+25+i*rowH;
        RECT item{r.left+6,y,r.right-6,y+rowH-1};
        const bool selected=(g_dropdown==Dropdown::Theme?idx==g_themeIndex:g_dropdown==Dropdown::Font?idx==g_fontIndex:g_dropdown==Dropdown::Antialiasing?g_msaaSamples==(idx==0?1:4):g_dropdown==Dropdown::FrameRate?FrameRateValues[static_cast<size_t>(idx)]==g_fpsLimit:idx==int(g_resolutionIndex));
        if(selected || g_dropdownHover==idx) DrawCard(dc,item,selected?t.hover:t.card,selected?t.accent:t.border,7);
        std::wstring label;
        if(g_dropdown==Dropdown::Theme) label=Themes[static_cast<size_t>(idx)].name;
        else if(g_dropdown==Dropdown::Font) label=FontFaces[static_cast<size_t>(idx)];
        else if(g_dropdown==Dropdown::Antialiasing) label=AntialiasingNames[static_cast<size_t>(idx)];
        else if(g_dropdown==Dropdown::FrameRate) label=FrameRateNames[static_cast<size_t>(idx)];
        else if(idx<int(g_resolutions.size())) label=std::to_wstring(g_resolutions[static_cast<size_t>(idx)].first)+L" × "+std::to_wstring(g_resolutions[static_cast<size_t>(idx)].second);
        Text(dc,item.left+8,item.top,item.right-item.left-16,item.bottom-item.top,label.c_str(),10,selected?t.accent:t.ink,selected?FW_SEMIBOLD:FW_NORMAL);
    }
    const int total=g_dropdown==Dropdown::Theme?int(Themes.size()):g_dropdown==Dropdown::Font?int(FontFaces.size()):g_dropdown==Dropdown::Antialiasing?int(AntialiasingNames.size()):g_dropdown==Dropdown::FrameRate?int(FrameRateNames.size()):int(g_resolutions.size());
    if(total>rows){
        const int railX=r.right-5,railTop=r.top+27,railH=rows*rowH;
        FillSolid(dc,RECT{railX,railTop,railX+2,railTop+railH},t.border);
        const int thumbH=std::max(18,railH*rows/total);
        const int thumbY=railTop+(railH-thumbH)*first/std::max(1,total-rows);
        DrawPill(dc,RECT{railX-1,thumbY,railX+3,thumbY+thumbH},t.accent,t.accent);
    }
}
void PaintPanel(HWND w) {
    PAINTSTRUCT ps{}; HDC target=BeginPaint(w,&ps); if(!target)return;
    HDC dc=CreateCompatibleDC(target);
    HBITMAP bitmap=CreateCompatibleBitmap(target,PanelWidth*3,PanelHeight*3);
    if(!dc || !bitmap) { if(bitmap)DeleteObject(bitmap); if(dc)DeleteDC(dc); EndPaint(w,&ps); return; }
    HGDIOBJ oldBitmap=SelectObject(dc,bitmap);
    SetMapMode(dc,MM_ANISOTROPIC);
    SetWindowExtEx(dc,PanelWidth,PanelHeight,nullptr);
    SetViewportExtEx(dc,PanelWidth*3,PanelHeight*3,nullptr);
    const Theme& t=CurrentTheme();
    SetBackdropArt(dc,t);
    DrawHeader(dc,t); DrawNavigation(dc,t);
    switch(g_page){case Page::Graphics:DrawGraphicsPage(dc,t);break;case Page::Appearance:DrawAppearancePage(dc,t);break;case Page::Controls:DrawControlsPage(dc,t);break;}
    DrawDropdown(dc,t);
    SetStretchBltMode(target,HALFTONE); SetBrushOrgEx(target,0,0,nullptr);
    StretchBlt(target,0,0,PanelWidth,PanelHeight,dc,0,0,PanelWidth,PanelHeight,SRCCOPY);
    SelectObject(dc,oldBitmap);DeleteObject(bitmap);DeleteDC(dc);EndPaint(w,&ps);
}
void PositionPanel() {
    if(!g_hostWindow||!IsWindow(g_hostWindow)||!g_panelWindow||!g_panelVisible)return;
    RECT c{};if(!GetClientRect(g_hostWindow,&c))return;POINT o{0,0};ClientToScreen(g_hostWindow,&o);
    const int aw=static_cast<int>(c.right-c.left),ah=static_cast<int>(c.bottom-c.top);
    const int x=o.x+std::max(0,(aw-PanelWidth)/2),y=o.y+std::max(0,(ah-PanelHeight)/2);
    SetWindowPos(g_panelWindow,HWND_TOP,x,y,PanelWidth,PanelHeight,SWP_NOACTIVATE|SWP_SHOWWINDOW);
