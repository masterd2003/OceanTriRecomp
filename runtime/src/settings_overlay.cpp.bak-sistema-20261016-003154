void Activate(int hit) {
    if(hit>=100&&hit<=102){g_page=hit==100?Page::Graphics:hit==101?Page::Appearance:Page::Controls;g_dropdown=Dropdown::None;g_hover=-1;}
    else switch(hit){
        case 20:ToggleFps();break;
        case 21:OpenDropdown(Dropdown::Resolution);break;
        case 22:ToggleVsync();break;
        case 23:ToggleWide();break;
        case 24:ToggleFit();break;
        case 25:ResetSettings();break;
        case 26:OpenDropdown(Dropdown::Antialiasing);break;
        case 27:OpenDropdown(Dropdown::FrameRate);break;
        case 30:OpenDropdown(Dropdown::Theme);break;
        case 31:OpenDropdown(Dropdown::Font);break;
        case 90:SetVisible(false);return;
        default:return;
    }
    if(g_panelWindow)InvalidateRect(g_panelWindow,nullptr,FALSE);
}
int HitTest(POINT p) {
    if(Contains(CloseRect(),p))return 90;
    for(int i=0;i<3;++i)if(Contains(NavRect(i),p))return 100+i;
    if(g_page==Page::Graphics){
        if(Contains(FpsRect(),p))return 20;
        if(Contains(ResolutionButtonRect(),p))return 21;
        if(Contains(VsyncRect(),p))return 22;
        if(Contains(WideRect(),p))return 23;
        if(Contains(FitRect(),p))return 24;
        if(Contains(ResetRect(),p))return 25;
        if(Contains(AntialiasingButtonRect(),p))return 26;
        if(Contains(FrameLimitRect(),p))return 27;
    }
    if(g_page==Page::Appearance){if(Contains(ThemeButtonRect(),p))return 30;if(Contains(FontButtonRect(),p))return 31;}
    if(g_page==Page::Controls){for(int i=0;i<3;++i){RECT r{ContentX,153+i*69,ContentRight,211+i*69};if(Contains(r,p))return 40+i;}}
    return -1;
}
void SelectDropdownItem(int idx) {
    if(g_dropdown==Dropdown::Theme)ApplyThemeSelection(idx);
    else if(g_dropdown==Dropdown::Resolution)ChangeResolutionTo(idx);
    else if(g_dropdown==Dropdown::Font && idx>=0 && idx<int(FontFaces.size())) { g_fontIndex=idx; SaveTheme(); }
    else if(g_dropdown==Dropdown::Antialiasing)ApplyAntialiasingSelection(idx);
    else if(g_dropdown==Dropdown::FrameRate)ChangeFrameLimitTo(idx);
    g_dropdown=Dropdown::None;g_dropdownHover=-1;
    if(g_panelWindow)InvalidateRect(g_panelWindow,nullptr,FALSE);
    if(g_hudWindow)InvalidateRect(g_hudWindow,nullptr,TRUE);
}
LRESULT CALLBACK PanelProc(HWND w,UINT m,WPARAM wp,LPARAM lp) {
    switch(m){
    case WM_ERASEBKGND:return 1;
    case WM_PAINT:PaintPanel(w);return 0;
    case WM_MOUSEMOVE:{
        TRACKMOUSEEVENT track{sizeof(track),TME_LEAVE,w,0};TrackMouseEvent(&track);
        POINT p{GET_X_LPARAM(lp),GET_Y_LPARAM(lp)};
        int d=DropdownItemAt(p);
        if(g_dropdown!=Dropdown::None){if(d!=g_dropdownHover){g_dropdownHover=d;InvalidateRect(w,nullptr,FALSE);}return 0;}
        int h=HitTest(p);if(h!=g_hover){g_hover=h;InvalidateRect(w,nullptr,FALSE);}return 0;
    }
    case WM_MOUSELEAVE:g_hover=-1;g_dropdownHover=-1;InvalidateRect(w,nullptr,FALSE);return 0;
    case WM_LBUTTONUP:{
        POINT p{GET_X_LPARAM(lp),GET_Y_LPARAM(lp)};
        if(g_dropdown!=Dropdown::None){
            if(Contains(DropdownRect(),p)){int idx=DropdownItemAt(p);if(idx>=0)SelectDropdownItem(idx);return 0;}
            g_dropdown=Dropdown::None;g_dropdownHover=-1;
        }
        Activate(HitTest(p));if(g_panelWindow)InvalidateRect(w,nullptr,FALSE);return 0;
    }
    case WM_MOUSEWHEEL:{
        if(g_dropdown!=Dropdown::None){const int delta=GET_WHEEL_DELTA_WPARAM(wp);SetDropdownScroll(DropdownTopScroll()+(delta>0?-3:3));InvalidateRect(w,nullptr,FALSE);return 0;}return 0;
    }
    case WM_KEYDOWN:
        if(wp==VK_ESCAPE||wp==VK_F1){if(g_dropdown!=Dropdown::None){g_dropdown=Dropdown::None;InvalidateRect(w,nullptr,FALSE);}else SetVisible(false);return 0;}
        if(g_dropdown!=Dropdown::None&&(wp==VK_UP||wp==VK_DOWN)){SetDropdownScroll(DropdownTopScroll()+(wp==VK_UP?-1:1));InvalidateRect(w,nullptr,FALSE);return 0;}
        if(wp==VK_TAB){g_page=g_page==Page::Graphics?Page::Appearance:g_page==Page::Appearance?Page::Controls:Page::Graphics;g_dropdown=Dropdown::None;InvalidateRect(w,nullptr,FALSE);return 0;}
        return 0;
    case WM_CLOSE:SetVisible(false);return 0;
    case WM_DPICHANGED:InvalidateRect(w,nullptr,FALSE);return 0;
    default:return DefWindowProcW(w,m,wp,lp);
    }
}
LRESULT CALLBACK HudProc(HWND w,UINT m,WPARAM wp,LPARAM lp) {
    (void)wp;(void)lp;
    switch(m){
    case WM_NCHITTEST:return HTTRANSPARENT;
    case WM_ERASEBKGND:return 1;
    case WM_PAINT:{
        PAINTSTRUCT ps{};HDC dc=BeginPaint(w,&ps);if(dc){const Theme&t=CurrentTheme();
