std::filesystem::path ExecutableDirectory() {
    wchar_t modulePath[32768]{};
    const DWORD length = GetModuleFileNameW(nullptr, modulePath, static_cast<DWORD>(32768));
    if (length > 0 && length < 32768)
        return std::filesystem::path(std::wstring(modulePath, length)).parent_path();
    return std::filesystem::current_path();
}
std::filesystem::path ThemeSettingsPath() { return ExecutableDirectory() / L"MH3UI.theme.v2"; }
std::filesystem::path GraphicsSettingsPath() { return ExecutableDirectory() / L"MH3UI.graphics"; }
void LoadGraphicsSettings() {
    int samples = 1, vsync = 1, renderResolution = 0, fpsLimit = 60;
    std::ifstream in(GraphicsSettingsPath());
    if (in >> samples >> vsync) {
        if (samples == 1 || samples == 4) g_msaaSamples = samples;
        else g_msaaSamples = 1;
        g_vsync = vsync != 0;
        if (in >> renderResolution) g_resolutionIndex = static_cast<size_t>(std::clamp(renderResolution, 0, 5));
        if (in >> fpsLimit && std::find(FrameRateValues.begin(), FrameRateValues.end(), fpsLimit) != FrameRateValues.end())
            g_fpsLimit = fpsLimit;
    }
    MH3FrameRateControl::SetTargetFPS(g_fpsLimit);
    aurora_enable_vsync(g_vsync);
}
void SaveGraphicsSettings() {
    std::ofstream out(GraphicsSettingsPath(), std::ios::trunc);
    if (out) out << g_msaaSamples << ' ' << (g_vsync ? 1 : 0) << ' ' << g_resolutionIndex << ' ' << g_fpsLimit << '\n';
}
void LoadTheme() {
    std::ifstream in(ThemeSettingsPath());
    int selected = 6, font = 0;
    if (in >> selected && selected >= 0 && selected < static_cast<int>(Themes.size()))
        g_themeIndex = selected;
    if (in >> font && font >= 0 && font < static_cast<int>(FontFaces.size()))
        g_fontIndex = font;
}
void SaveTheme() {
    std::ofstream out(ThemeSettingsPath(), std::ios::trunc);
    if (out) out << g_themeIndex << ' ' << g_fontIndex << '\n';
}
void FillSolid(HDC dc, RECT r, COLORREF color) {
    HBRUSH b = CreateSolidBrush(color);
    if (b) { ::FillRect(dc, &r, b); DeleteObject(b); }
}
void Line(HDC dc, int x1, int y1, int x2, int y2, COLORREF color, int width = 1) {
    HPEN p = CreatePen(PS_SOLID, width, color);
    if (!p) return;
    HGDIOBJ old = SelectObject(dc, p);
    MoveToEx(dc, x1, y1, nullptr);
    LineTo(dc, x2, y2);
    SelectObject(dc, old);
    DeleteObject(p);
}
void DrawThemeTexture(HDC dc, const Theme& t) {
    const COLORREF base = t.panel;
    const COLORREF edge = t.border;
    const COLORREF ink = RGB((GetRValue(base) * 2 + GetRValue(edge)) / 3,
                             (GetGValue(base) * 2 + GetGValue(edge)) / 3,
                             (GetBValue(base) * 2 + GetBValue(edge)) / 3);
    HPEN pen = CreatePen(PS_SOLID, 1, ink);
    if (!pen) return;
    HGDIOBJ old = SelectObject(dc, pen);
    const int motif = g_themeIndex % 8;
    if (g_themeIndex == 6) {
        for (int y = 88; y < 458; y += 13) {
            const int drift = (y * 7) % 19;
            Line(dc, 20 + drift, y, 466 - (drift / 3), y, ink, 1);
        }
        for (int i = 0; i < 11; ++i) {
            const int x = 486 + (i % 4) * 45;
            const int y = 112 + (i / 4) * 97;
            Arc(dc, x, y, x + 31, y + 31, x + 4, y + 16, x + 16, y + 3);
        }
        Ellipse(dc, 531, 94, 653, 216);
        Ellipse(dc, 541, 104, 643, 206);
        Line(dc, 592, 107, 592, 203, t.border, 1);
        Line(dc, 544, 155, 640, 155, t.border, 1);
        SelectObject(dc, old);
        DeleteObject(pen);
        return;
    }
    switch (motif) {
    case 0: // Mist of Moga
        for (int i = 0; i < 6; ++i) Arc(dc, 500-i*7, 78+i*12, 682-i*4, 154+i*14, 524, 112+i*10, 654, 88+i*11);
        break;
    case 1: // Bubbles in deep water
        for (int y = 94; y < 448; y += 36) for (int x = 508 + ((y/36)%2)*15; x < 666; x += 30) {
            Ellipse(dc, x, y, x+9, y+9); Line(dc, x+2, y+2, x+4, y+2, t.hover, 1);
        }
        break;
    case 2: // Forged, diagonal grain
        for (int x = 455; x < 690; x += 18) Line(dc, x, 83, x-72, 455, ink, 1);
        break;
    case 3: // Guild paper crosshatch
        for (int y = 100; y < 455; y += 24) Line(dc, 488, y, 673, y, ink, 1);
        for (int x = 500; x < 680; x += 24) Line(dc, x, 82, x, 455, ink, 1);
        break;
    case 4: // Lagiacrus scales
        for (int y = 96; y < 456; y += 23) for (int x = 500 + ((y/23)%2)*12; x < 680; x += 24)
            Arc(dc, x, y, x+24, y+22, x, y+11, x+12, y);
        break;
    case 5: // Wyvern claw marks
        for (int i = 0; i < 8; ++i) {
            Line(dc, 530+i*18, 91, 505+i*18, 142, ink, 2);
            Line(dc, 505+i*18, 340, 530+i*18, 391, ink, 2);
        }
        break;
    case 6: // Hunter's star map
        for (int i = 0; i < 7; ++i) {
            const int x = 520 + (i%3)*48, y = 106 + (i/3)*104;
            Line(dc, x-5, y, x+5, y, ink, 1); Line(dc, x, y-5, x, y+5, ink, 1);
            Line(dc, x-3, y-3, x+3, y+3, ink, 1); Line(dc, x-3, y+3, x+3, y-3, ink, 1);
        }
        break;
    default: // Volcanic contour rings
        for (int i = 0; i < 7; ++i) Ellipse(dc, 505+i*7, 98+i*8, 603+i*11, 199+i*10);
        break;
    }
    SelectObject(dc, old);
    DeleteObject(pen);
}

void DrawTextLine(HDC dc, RECT r, const wchar_t* text, int size, COLORREF color,
                  int weight = FW_NORMAL, UINT fmt = DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS) {
    size = std::max(size, 11);
    HFONT f = CreateFontW(-size, 0, 0, 0, weight, FALSE, FALSE, FALSE,
                          DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                          ANTIALIASED_QUALITY, DEFAULT_PITCH | FF_DONTCARE, CurrentFontFace());
    if (!f) return;
    HGDIOBJ old = SelectObject(dc, f);
    SetBkMode(dc, TRANSPARENT);
    SetTextColor(dc, color);
    DrawTextW(dc, text, -1, &r, fmt | DT_NOPREFIX);
    SelectObject(dc, old);
    DeleteObject(f);
}
void Text(HDC dc, int x, int y, int w, int h, const wchar_t* value, int size, COLORREF color,
          int weight = FW_NORMAL, UINT fmt = DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS) {
    DrawTextLine(dc, RECT{x, y, x + w, y + h}, value, size, color, weight, fmt);
}
void DrawCard(HDC dc, RECT r, COLORREF fill, COLORREF edge, int radius = 14) {
    const int style = CurrentTheme().style;
    if (style == 0 || style == 2 || style == 4) {
        const COLORREF shadow = RGB((GetRValue(CurrentTheme().bg) + GetRValue(edge)) / 2,
                                    (GetGValue(CurrentTheme().bg) + GetGValue(edge)) / 2,
                                    (GetBValue(CurrentTheme().bg) + GetBValue(edge)) / 2);
        HBRUSH shadowBrush = CreateSolidBrush(shadow);
        if (shadowBrush) {
            HGDIOBJ old = SelectObject(dc, shadowBrush);
            HGDIOBJ oldPen = SelectObject(dc, GetStockObject(NULL_PEN));
            RoundRect(dc, r.left + 2, r.top + 3, r.right + 2, r.bottom + 3, radius * 2, radius * 2);
            SelectObject(dc, oldPen); SelectObject(dc, old); DeleteObject(shadowBrush);
        }
    }
    HBRUSH brush = CreateSolidBrush(fill);
    HPEN pen = CreatePen(PS_SOLID, 1, edge);
    if (!brush || !pen) { if (brush) DeleteObject(brush); if (pen) DeleteObject(pen); return; }
    HGDIOBJ oldBrush = SelectObject(dc, brush);
    HGDIOBJ oldPen = SelectObject(dc, pen);
    RoundRect(dc, r.left, r.top, r.right, r.bottom,
              (style == 1 ? std::max(16, radius * 2) : radius * 2),
              (style == 1 ? std::max(16, radius * 2) : radius * 2));
    SelectObject(dc, oldBrush); SelectObject(dc, oldPen);
    DeleteObject(brush); DeleteObject(pen);
    if (style == 2) { // Liquid Glass: a visible specular edge and a secondary inner rim.
        Line(dc, r.left + radius, r.top + 2, r.right - radius, r.top + 2,
             CurrentTheme().light ? RGB(255,255,255) : RGB(116,235,241), 2);
        HPEN rim = CreatePen(PS_SOLID, 1, CurrentTheme().light ? RGB(255,255,255) : RGB(70,174,188));
        if (rim) {
            HGDIOBJ old = SelectObject(dc, rim);
            HGDIOBJ nullBrush = GetStockObject(NULL_BRUSH);
            HGDIOBJ oldB = SelectObject(dc, nullBrush);
            RoundRect(dc, r.left + 3, r.top + 3, r.right - 3, r.bottom - 3, radius * 2 - 4, radius * 2 - 4);
            SelectObject(dc, oldB); SelectObject(dc, old); DeleteObject(rim);
        }
    } else if (style == 0) {
        Line(dc, r.left + radius, r.top + 2, r.right - radius, r.top + 2,
             CurrentTheme().light ? RGB(255,255,255) : RGB(105,133,155));
    } else if (style == 5) {
        HPEN inner = CreatePen(PS_SOLID, 1, CurrentTheme().border);
        if (inner) {
            HGDIOBJ old = SelectObject(dc, inner);
            HGDIOBJ nullBrush = SelectObject(dc, GetStockObject(NULL_BRUSH));
            RoundRect(dc, r.left + 4, r.top + 4, r.right - 4, r.bottom - 4,
                      std::max(8, radius * 2 - 5), std::max(8, radius * 2 - 5));
            SelectObject(dc, nullBrush); SelectObject(dc, old); DeleteObject(inner);
        }
    }
}
void DrawPill(HDC dc, RECT r, COLORREF fill, COLORREF edge) {
    HBRUSH b = CreateSolidBrush(fill);
    HPEN p = CreatePen(PS_SOLID, 1, edge);
    if (!b || !p) { if (b) DeleteObject(b); if (p) DeleteObject(p); return; }
    HGDIOBJ ob = SelectObject(dc, b), op = SelectObject(dc, p);
    RoundRect(dc, r.left, r.top, r.right, r.bottom, r.bottom-r.top, r.bottom-r.top);
    SelectObject(dc, ob); SelectObject(dc, op); DeleteObject(b); DeleteObject(p);
}
void DrawSwitch(HDC dc, RECT r, bool on, const Theme& t) {
    COLORREF track = on ? t.accent : t.border;
    DrawPill(dc, r, track, track);
    const int d = r.bottom - r.top - 6;
    const int x = on ? r.right - d - 3 : r.left + 3;
    HBRUSH b = CreateSolidBrush(on ? RGB(255,255,255) : t.panel);
    HPEN p = CreatePen(PS_SOLID, 1, on ? RGB(255,255,255) : t.muted);
    if (b && p) {
