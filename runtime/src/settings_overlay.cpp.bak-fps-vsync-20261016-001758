void PaintPanel(HWND window) {
    PAINTSTRUCT paint{};
    HDC dc = BeginPaint(window, &paint);
    if (dc) {
        SetBkMode(dc, TRANSPARENT);
        if (!g_panelHasGlass) {
            RECT client{};
            GetClientRect(window, &client);
            HBRUSH backdrop = CreateSolidBrush(RGB(5, 9, 10));
            if (backdrop) { FillRect(dc, &client, backdrop); DeleteObject(backdrop); }
        }
        if (g_page == Page::Home)
            DrawHome(dc);
        else
            DrawSettings(dc);
        EndPaint(window, &paint);
    }
}

void PositionPanel() {
    if (!g_hostWindow || !g_panelWindow || !g_panelVisible)
        return;

    RECT client{};
    if (!GetClientRect(g_hostWindow, &client))
        return;
    POINT origin{client.left, client.top};
    ClientToScreen(g_hostWindow, &origin);
    const int availableWidth = client.right - client.left;
    const int availableHeight = client.bottom - client.top;
    const int x = origin.x + std::max(0, (availableWidth - PanelWidth) / 2);
    const int y = origin.y + std::max(0, (availableHeight - PanelHeight) / 2);
    SetWindowPos(g_panelWindow, HWND_TOP, x, y, PanelWidth, PanelHeight, SWP_NOACTIVATE | SWP_SHOWWINDOW);
}

void PositionHud() {
    if (!g_hostWindow || !g_hudWindow || !g_showFps)
        return;
    RECT client{};
    if (!GetClientRect(g_hostWindow, &client))
        return;
    POINT topLeft{client.left, client.top};
    POINT bottomRight{client.right, client.bottom};
    ClientToScreen(g_hostWindow, &topLeft);
    ClientToScreen(g_hostWindow, &bottomRight);
    // Anchor against the actual right edge of the game's client rectangle.
    const int x = std::max(topLeft.x + 8, bottomRight.x - HudWidth - 16);
    const int y = topLeft.y + 16;
    SetWindowPos(g_hudWindow, HWND_TOP, x, y, HudWidth, HudHeight, SWP_NOACTIVATE | SWP_SHOWWINDOW);
}

void SetVisible(bool visible) {
    g_panelVisible = visible;
    if (!g_panelWindow)
        return;
    if (visible) {
        g_page = Page::Home;
        g_hover = -1;
        PositionPanel();
        ShowWindow(g_panelWindow, SW_SHOW);
        SetForegroundWindow(g_panelWindow);
        SetFocus(g_panelWindow);
        InvalidateRect(g_panelWindow, nullptr, FALSE);
    } else {
        ShowWindow(g_panelWindow, SW_HIDE);
        if (g_hostWindow && IsWindow(g_hostWindow))
            SetForegroundWindow(g_hostWindow);
    }
}

void ToggleVisible() { SetVisible(!g_panelVisible); }

void ChangeResolution(int direction) {
    if (g_resolutions.empty())
        LoadResolutions();
    if (g_resolutions.empty())
        return;
    const auto count = static_cast<int>(g_resolutions.size());
    int next = static_cast<int>(g_resolutionIndex) + direction;
    if (next < 0) next = count - 1;
    if (next >= count) next = 0;
    g_resolutionIndex = static_cast<size_t>(next);
    const auto selected = g_resolutions[g_resolutionIndex];
    RuntimeConfigFile::SetWindowSize(selected.width, selected.height);
    if (g_sdlWindow)
        SDL_SetWindowSize(g_sdlWindow, static_cast<int>(selected.width), static_cast<int>(selected.height));
    PositionPanel();
    PositionHud();
    if (g_panelWindow) InvalidateRect(g_panelWindow, nullptr, FALSE);
}

void ToggleFps() {
    g_showFps = !g_showFps;
    RuntimeConfigFile::SetShowFps(g_showFps);
    if (g_hudWindow) {
        if (g_showFps) {
            PositionHud();
        } else {
            ShowWindow(g_hudWindow, SW_HIDE);
        }
    }
    if (g_panelWindow) InvalidateRect(g_panelWindow, nullptr, FALSE);
}

void ActivateHit(int hit) {
    switch (hit) {
    case 0:
        g_page = Page::Settings;
        LoadResolutions();
        break;
    case 1:
        // Push a normal SDL quit event so the host runtime can shut down cleanly.
        {
            SDL_Event quit{};
            quit.type = SDL_EVENT_QUIT;
            SDL_PushEvent(&quit);
        }
        break;
    case 2:
        ToggleFps();
        return;
    case 3:
        ChangeResolution(-1);
        return;
    case 4:
        ChangeResolution(1);
        return;
    case 5:
        g_page = Page::Home;
        break;
    case 6:
        SetVisible(false);
        return;
    default:
        return;
    }
    if (g_panelWindow) InvalidateRect(g_panelWindow, nullptr, FALSE);
}

LRESULT CALLBACK PanelProc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
    switch (message) {
    case WM_ERASEBKGND:
        return 1; // Leave the DWM backdrop visible through the glass margins.
    case WM_PAINT:
        PaintPanel(window);
        return 0;
    case WM_MOUSEMOVE: {
        const POINT point{GET_X_LPARAM(lparam), GET_Y_LPARAM(lparam)};
        const int hit = HitTest(point);
        if (hit != g_hover) {
            g_hover = hit;
            InvalidateRect(window, nullptr, FALSE);
        }
        return 0;
    }
    case WM_LBUTTONUP: {
        const POINT point{GET_X_LPARAM(lparam), GET_Y_LPARAM(lparam)};
        ActivateHit(HitTest(point));
        return 0;
    }
    case WM_KEYDOWN:
        if (wparam == VK_ESCAPE || wparam == VK_F1) {
            SetVisible(false);
            return 0;
        }
        if (g_page == Page::Settings && (wparam == VK_LEFT || wparam == VK_RIGHT)) {
            ChangeResolution(wparam == VK_LEFT ? -1 : 1);
            return 0;
        }
        if (g_page == Page::Settings && (wparam == VK_SPACE || wparam == VK_RETURN)) {
            ToggleFps();
            return 0;
        }
        return 0;
    case WM_CLOSE:
        SetVisible(false);
        return 0;
    case WM_DESTROY:
        if (window == g_panelWindow) g_panelWindow = nullptr;
        return 0;
    default:
        return DefWindowProcW(window, message, wparam, lparam);
    }
}

LRESULT CALLBACK HudProc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
    (void)wparam;
    (void)lparam;
    switch (message) {
    case WM_NCHITTEST:
        return HTTRANSPARENT;
    case WM_ERASEBKGND:
        return 1;
    case WM_PAINT: {
        PAINTSTRUCT paint{};
        HDC dc = BeginPaint(window, &paint);
        if (dc) {
            if (!g_hudHasGlass) {
                RECT client{};
                GetClientRect(window, &client);
                HBRUSH backdrop = CreateSolidBrush(RGB(5, 10, 11));
                if (backdrop) { FillRect(dc, &client, backdrop); DeleteObject(backdrop); }
            }
            RoundedCard(dc, RECT{0, 0, HudWidth, HudHeight}, RGB(5, 10, 11), Accent, 18);
            DrawTextLine(dc, 8, 0, HudWidth - 16, HudHeight, (L"FPS  " + std::to_wstring(static_cast<unsigned>(g_fps + 0.5))).c_str(), 13, Ink,
                         FW_SEMIBOLD, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
            EndPaint(window, &paint);
        }
        return 0;
    }
    case WM_MOUSEACTIVATE:
        return MA_NOACTIVATE;
    default:
        return DefWindowProcW(window, message, wparam, lparam);
    }
}

bool RegisterWindowClass(const wchar_t* name, WNDPROC procedure) {
    WNDCLASSEXW wc{};
    wc.cbSize = sizeof(wc);
    wc.lpfnWndProc = procedure;
    wc.hInstance = GetModuleHandleW(nullptr);
    wc.hCursor = LoadCursorW(nullptr, IDC_ARROW);
    wc.lpszClassName = name;
    if (RegisterClassExW(&wc))
        return true;
    return GetLastError() == ERROR_CLASS_ALREADY_EXISTS;
}

void EnsureWindows() {
    if (!g_hostWindow || !IsWindow(g_hostWindow))
        return;

    const HINSTANCE instance = GetModuleHandleW(nullptr);
    if (!g_panelWindow && RegisterWindowClass(OverlayClassName, PanelProc)) {
        g_panelWindow = CreateWindowExW(WS_EX_TOOLWINDOW, OverlayClassName, L"Monster Hunter Tri · Ajustes", WS_POPUP,
                                        CW_USEDEFAULT, CW_USEDEFAULT, PanelWidth, PanelHeight, g_hostWindow, nullptr, instance, nullptr);
        if (g_panelWindow) {
            g_panelHasGlass = ApplyGlass(g_panelWindow);
            ShowWindow(g_panelWindow, SW_HIDE);
        }
    }
    if (!g_hudWindow && RegisterWindowClass(HudClassName, HudProc)) {
        g_hudWindow = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_LAYERED | WS_EX_TRANSPARENT, HudClassName, L"MH3 FPS",
                                      WS_POPUP, CW_USEDEFAULT, CW_USEDEFAULT, HudWidth, HudHeight, g_hostWindow, nullptr, instance, nullptr);
        if (g_hudWindow) {
            SetLayeredWindowAttributes(g_hudWindow, 0, 238, LWA_ALPHA);
            g_hudHasGlass = ApplyGlass(g_hudWindow);
            ShowWindow(g_hudWindow, SW_HIDE);
        }
    }
}

void DispatchWindowMessages(HWND window) {
    if (!window)
        return;
    MSG msg{};
    while (PeekMessageW(&msg, window, 0, 0, PM_REMOVE)) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }
}

