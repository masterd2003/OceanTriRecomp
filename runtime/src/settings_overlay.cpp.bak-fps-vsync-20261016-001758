bool SameResolution(const Resolution& a, const Resolution& b) {
    return a.width == b.width && a.height == b.height;
}

void AddResolution(uint32_t width, uint32_t height) {
    if (width < 640 || height < 480 || width > 7680 || height > 4320)
        return;

    const Resolution candidate{width, height};
    if (std::none_of(g_resolutions.begin(), g_resolutions.end(), [&](const Resolution& item) { return SameResolution(item, candidate); }))
        g_resolutions.push_back(candidate);
}

void LoadResolutions() {
    g_resolutions.clear();

    DEVMODEW mode{};
    mode.dmSize = sizeof(mode);
    for (DWORD i = 0; EnumDisplaySettingsW(nullptr, i, &mode); ++i) {
        if (mode.dmPelsWidth >= 640 && mode.dmPelsHeight >= 480)
            AddResolution(mode.dmPelsWidth, mode.dmPelsHeight);
        mode = {};
        mode.dmSize = sizeof(mode);
    }

    // Ensure a compact, conventional list is available on drivers that do not
    // report every window size as a display mode. These are real pixel sizes.
    AddResolution(960, 544);
    AddResolution(1280, 720);
    AddResolution(1366, 768);
    AddResolution(1600, 900);
    AddResolution(1920, 1080);
    AddResolution(2560, 1440);
    AddResolution(3840, 2160);

    std::sort(g_resolutions.begin(), g_resolutions.end(), [](const Resolution& a, const Resolution& b) {
        if (a.width != b.width)
            return a.width < b.width;
        return a.height < b.height;
    });

    const Resolution current{RuntimeConfigFile::WindowWidth(960), RuntimeConfigFile::WindowHeight(544)};
    AddResolution(current.width, current.height);
    std::sort(g_resolutions.begin(), g_resolutions.end(), [](const Resolution& a, const Resolution& b) {
        return a.width != b.width ? a.width < b.width : a.height < b.height;
    });

    const auto found = std::find_if(g_resolutions.begin(), g_resolutions.end(), [&](const Resolution& item) { return SameResolution(item, current); });
    g_resolutionIndex = found == g_resolutions.end() ? 0 : size_t(found - g_resolutions.begin());
}

void DrawTextLine(HDC dc, int x, int y, int width, int height, const wchar_t* text, int size, COLORREF color, int weight = FW_NORMAL, UINT format = DT_LEFT | DT_VCENTER | DT_SINGLELINE) {
    HFONT font = CreateFontW(-size, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                            CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
    if (!font)
        return;
    HGDIOBJ oldFont = SelectObject(dc, font);
    SetBkMode(dc, TRANSPARENT);
    SetTextColor(dc, color);
    RECT rect{x, y, x + width, y + height};
    DrawTextW(dc, text, -1, &rect, format);
    SelectObject(dc, oldFont);
    DeleteObject(font);
}

void RoundedCard(HDC dc, const RECT& rect, COLORREF fill, COLORREF edge, int radius = 20) {
    HBRUSH brush = CreateSolidBrush(fill);
    HPEN pen = CreatePen(PS_SOLID, 1, edge);
    if (!brush || !pen) {
        if (brush) DeleteObject(brush);
        if (pen) DeleteObject(pen);
        return;
    }
    HGDIOBJ oldBrush = SelectObject(dc, brush);
    HGDIOBJ oldPen = SelectObject(dc, pen);
    RoundRect(dc, rect.left, rect.top, rect.right, rect.bottom, radius, radius);
    SelectObject(dc, oldBrush);
    SelectObject(dc, oldPen);
    DeleteObject(brush);
    DeleteObject(pen);
}

void AccentPill(HDC dc, int x, int y, int w, int h, COLORREF color) {
    RoundedCard(dc, RECT{x, y, x + w, y + h}, color, color, h);
}

