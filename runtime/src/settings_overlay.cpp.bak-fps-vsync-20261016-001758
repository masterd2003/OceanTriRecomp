// SetWindowCompositionAttribute enables the real Windows acrylic blur behind
// the custom-drawn client area. DWM's system backdrop is used as a fallback.
bool ApplyGlass(HWND window) {
    if (!window)
        return false;

    struct AccentPolicy { int state; int flags; DWORD gradientColor; int animationId; };
    enum { ACCENT_ENABLE_ACRYLICBLURBEHIND = 4, WCA_ACCENT_POLICY = 19 };
    struct WindowCompositionAttributeData { int attribute; void* data; size_t size; };
    using SetWindowCompositionAttributeFn = BOOL(WINAPI*)(HWND, WindowCompositionAttributeData*);

    bool glass = false;
    HMODULE user32 = GetModuleHandleW(L"user32.dll");
    auto setComposition = user32 ? reinterpret_cast<SetWindowCompositionAttributeFn>(GetProcAddress(user32, "SetWindowCompositionAttribute")) : nullptr;
    if (setComposition) {
        AccentPolicy policy{};
        policy.state = ACCENT_ENABLE_ACRYLICBLURBEHIND;
        policy.flags = 2;
        policy.gradientColor = 0xD9080D0F; // near-black translucent tint over the blurred desktop/game
        WindowCompositionAttributeData data{WCA_ACCENT_POLICY, &policy, sizeof(policy)};
        glass = setComposition(window, &data) != FALSE;
    }

    const BOOL darkMode = TRUE;
    const int backdrop = 3; // DWMSBT_TRANSIENTWINDOW, Windows 11 fallback
    const int corners = 2;  // DWMWCP_ROUND
    const COLORREF border = RGB(53, 226, 207);
    DwmSetWindowAttribute(window, static_cast<DWMWINDOWATTRIBUTE>(20), &darkMode, sizeof(darkMode));
    DwmSetWindowAttribute(window, static_cast<DWMWINDOWATTRIBUTE>(33), &corners, sizeof(corners));
    DwmSetWindowAttribute(window, static_cast<DWMWINDOWATTRIBUTE>(34), &border, sizeof(border));

    if (!glass) {
        // Windows 11's transient system backdrop is a real blurred DWM surface.
        glass = SUCCEEDED(DwmSetWindowAttribute(window, static_cast<DWMWINDOWATTRIBUTE>(38), &backdrop, sizeof(backdrop)));
        MARGINS margins{-1, -1, -1, -1};
        DwmExtendFrameIntoClientArea(window, &margins);
        DWM_BLURBEHIND blur{};
        blur.dwFlags = DWM_BB_ENABLE;
        blur.fEnable = TRUE;
        DwmEnableBlurBehindWindow(window, &blur);
    }
    return glass;
}

RECT HomeSettingsRect() { return RECT{28, 120, PanelWidth - 28, 198}; }
RECT HomeExitRect() { return RECT{28, 210, PanelWidth - 28, 288}; }
RECT SettingsFpsRect() { return RECT{28, 112, PanelWidth - 28, 174}; }
RECT SettingsResolutionRect() { return RECT{28, 186, PanelWidth - 28, 282}; }
RECT SettingsBackRect() { return RECT{170, 320, 390, 368}; }
RECT CloseRect() { return RECT{PanelWidth - 48, 17, PanelWidth - 20, 45}; }

bool Contains(RECT rect, POINT point) { return PtInRect(&rect, point) != FALSE; }

int HitTest(POINT p) {
    if (g_page == Page::Home) {
        if (Contains(HomeSettingsRect(), p)) return 0;
        if (Contains(HomeExitRect(), p)) return 1;
    } else {
        if (Contains(SettingsFpsRect(), p)) return 2;
        if (Contains(SettingsResolutionRect(), p)) {
            if (p.x >= 355 && p.x < 405) return 3;
            if (p.x >= 456 && p.x < 506) return 4;
        }
        if (Contains(SettingsBackRect(), p)) return 5;
    }
    if (Contains(CloseRect(), p)) return 6;
    return -1;
}

