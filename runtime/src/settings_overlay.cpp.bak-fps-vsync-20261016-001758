void AttachWindow(SDL_Window* window) noexcept {
    g_sdlWindow = window;
    g_hostWindow = nullptr;
    if (window) {
        const SDL_PropertiesID properties = SDL_GetWindowProperties(window);
        g_hostWindow = static_cast<HWND>(SDL_GetPointerProperty(properties, SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr));
    }
}

void InitializeRuntimeSettings() noexcept {
    g_showFps = RuntimeConfigFile::ShowFps(true);
    LoadResolutions();
    EnsureWindows();
    PositionHud();
    if (g_hudWindow && g_showFps) {
        ShowWindow(g_hudWindow, SW_SHOWNOACTIVATE);
        InvalidateRect(g_hudWindow, nullptr, TRUE);
    }
}

void HandleEvents(const AuroraEvent* events) noexcept {
    if (!events)
        return;
    for (const AuroraEvent* event = events; event->type != AURORA_NONE; ++event) {
        if (event->type != AURORA_SDL_EVENT || event->sdl.type != SDL_EVENT_KEY_DOWN || event->sdl.key.repeat)
            continue;
        const SDL_Keycode key = event->sdl.key.key;
        if (key == SDLK_ESCAPE || key == SDLK_F1) {
            EnsureWindows();
            ToggleVisible();
        }
    }
}

void Pump() noexcept {
    EnsureWindows();
    DispatchWindowMessages(g_panelWindow);
    DispatchWindowMessages(g_hudWindow);
    PositionHud();
    if (g_panelVisible)
        PositionPanel();
}

bool IsOpen() noexcept { return g_panelVisible; }
void Draw() noexcept { if (g_panelWindow && g_panelVisible) InvalidateRect(g_panelWindow, nullptr, FALSE); }
bool StartupScreenVisible() noexcept { return false; }
void NotifyStrapInputAccepted() noexcept {}

void AdvancePresentedFrame() noexcept {
    if (g_showFps && g_hudWindow) {
        ++g_frameCount;
        const auto now = std::chrono::steady_clock::now();
        const double elapsed = std::chrono::duration<double>(now - g_lastFpsUpdate).count();
        if (elapsed >= 0.5) {
            g_fps = static_cast<double>(g_frameCount) / elapsed;
            g_frameCount = 0;
            g_lastFpsUpdate = now;
            PositionHud();
            InvalidateRect(g_hudWindow, nullptr, FALSE);
        }
    }
}

void ReleaseControllers() noexcept {
    if (g_panelWindow) ShowWindow(g_panelWindow, SW_HIDE);
    if (g_hudWindow) ShowWindow(g_hudWindow, SW_HIDE);
    g_panelVisible = false;
}

